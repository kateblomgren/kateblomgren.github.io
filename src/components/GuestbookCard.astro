---
import rays from '../assets/rays.svg';

interface Props {
  author: string;
  content: string;
  country: string;
  link?: string | null;
  variant: {
    pill: string;
    country: string;
    countryPos: string;
  };
}

const { author, content, country, link, variant: v } = Astro.props;
---

<div class="relative overflow-visible">
  <svg class="absolute inset-0 w-full h-full" viewBox="0 0 382 362" preserveAspectRatio="none" fill="none" xmlns="http://www.w3.org/2000/svg">
    <rect x="11.5" y="15.5" width="359" height="331" fill="white" stroke="black" stroke-width="2" vector-effect="non-scaling-stroke"/>
    <path d="M1.5 15.5L380.5 15.5" stroke="black" stroke-width="2" stroke-linecap="round" vector-effect="non-scaling-stroke"/>
    <path d="M1.5 346.5L380.5 346.5" stroke="black" stroke-width="2" stroke-linecap="round" vector-effect="non-scaling-stroke"/>
    <path d="M11.5 360.5L11.5 1.50001" stroke="black" stroke-width="2" stroke-linecap="round" vector-effect="non-scaling-stroke"/>
    <path d="M370.5 360.5L370.5 1.50001" stroke="black" stroke-width="2" stroke-linecap="round" vector-effect="non-scaling-stroke"/>
  </svg>

  <div class="relative z-10 px-7 pt-6 pb-14">
    <h2 class="text-2xl font-bold leading-tight mb-2">{author}</h2>

    {link && (
      <div class="flex items-center gap-2 mb-4">
        <a
          href={link}
          target="_blank"
          class={`${v.pill} rounded-full px-4 py-1 text-sm font-medium truncate max-w-[180px]`}
        >
          {link}
        </a>
        <img src={rays.src} alt="" width="22" class="shrink-0" />
      </div>
    )}

    <p class="text-sm leading-relaxed">
      {content}
    </p>
  </div>

  <div class={`absolute ${v.countryPos} z-20 ${v.country} px-4 py-1 text-sm font-bold border-2 border-black shadow-[3px_3px_0px_rgba(0,0,0,0.2)]`}>
    {country}
  </div>
</div>
