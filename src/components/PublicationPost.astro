---
import '../styles/global.css'
import Layout from '../layouts/Layout.astro';
import AppHeader from './Header.astro';
import AppFooter from './Footer.astro';

const { frontmatter } = Astro.props;
const image = frontmatter.image || '';

// --- Normalise authors to array ---
type Author = { name: string; url?: string };
let authors: Author[] = [];
if (Array.isArray(frontmatter.authors)) {
  authors = frontmatter.authors;
} else if (typeof frontmatter.authors === 'string') {
  authors = frontmatter.authors.split(',').map((n: string) => ({ name: n.trim(), url: '' }));
}

// --- Accent colour per type ---
const typeColors: Record<string, string> = {
  paper:    '#CCA0FF',
  thesis:   '#33BFFF',
  poster:   '#FEA7CC',
  talk:     '#FFDC58',
  workshop: '#AEF5D4',
  abstract: '#FF544F',
};
const accent = typeColors[frontmatter.type ?? ''] ?? '#CCA0FF';

// --- BibTeX (Last, First and Last, First …) ---
function toLastFirst(fullName: string): string {
  const parts = fullName.trim().split(/\s+/);
  if (parts.length <= 1) return parts[0] ?? fullName;
  const last  = parts[parts.length - 1];
  const first = parts.slice(0, -1).join(' ');
  return `${last}, ${first}`;
}

const authorBibtex = authors.map(a => toLastFirst(a.name)).join(' and ');
const keyAuthor    = authors[0]?.name.trim().split(/\s+/).pop()?.toLowerCase() ?? 'unknown';
const keyYear      = frontmatter.pubDate ? new Date(frontmatter.pubDate).getFullYear().toString() : 'nd';
const citeKey      = `${keyAuthor}${keyYear}`;

const bibType = frontmatter.type === 'thesis'
  ? 'mastersthesis'
  : (frontmatter.type === 'poster' || frontmatter.type === 'abstract')
    ? 'misc'
    : 'inproceedings';

const venueField = bibType === 'mastersthesis' ? 'school' : bibType === 'misc' ? 'note' : 'booktitle';

const bibtex =
`@${bibType}{${citeKey},
  author    = {${authorBibtex}},
  title     = {{${frontmatter.title}}},
  ${venueField.padEnd(9)} = {${frontmatter.venue}},
  year      = {${keyYear}}
}`;

// --- Tape colours cycling for author cards ---
const tapeColors = ['#FEA7CC', '#AEF5D4', '#FFDC58', '#CCA0FF', '#33BFFF'];
const rotations  = ['-1.5deg', '1deg', '-0.8deg', '1.5deg', '-1.2deg'];
---

<Layout>
  <AppHeader />

  <article class="pt-10 pb-32 px-4">
    <div class="max-w-4xl mx-auto">

      <!-- Back -->
      <a href="/outputs/" class="inline-flex items-center gap-1 text-sm text-gray-500 hover:text-black transition-colors mb-8">
        ← Back to Outputs
      </a>

      <!-- Title -->
      <h1 class="text-3xl md:text-4xl font-black leading-snug mb-10">{frontmatter.title}</h1>

      <!-- Two-column layout -->
      <div class="flex flex-col-reverse md:flex-row gap-10 md:gap-14 items-start">

        <!-- ── LEFT: main content ── -->
        <div class="flex-1 min-w-0">

          {image && (
            <div class="float-left mr-8 mb-4 max-w-[260px] w-full">
              <!-- Polaroid: outer black border → white padding → inner black border → photo -->
              <div class="border-2 border-black bg-white shadow-[4px_4px_0px_rgba(0,0,0,0.25)] group/pol">
                <div class="p-2 pb-0">
                  <div class="border-2 border-black overflow-hidden">
                    <img
                      id="polaroid-img"
                      src={image}
                      alt={frontmatter.imageCaption || frontmatter.title}
                      class="block object-cover max-h-[250px] w-full cursor-zoom-in
                             transition-all duration-300
                             group-hover/pol:brightness-110 group-hover/pol:scale-[1.03]"
                    />
                  </div>
                </div>
                <!-- hover hint -->
                <div class="opacity-0 group-hover/pol:opacity-100 transition-opacity duration-200 absolute -top-6 left-1/2 -translate-x-1/2 bg-black text-white text-[10px] px-2 py-0.5 whitespace-nowrap pointer-events-none">
                  click to enlarge
                </div>
                <!-- thick white caption strip -->
                <div class="px-3 py-4 min-h-[52px] flex items-center">
                  {frontmatter.imageCaption
                    ? <p class="text-xs text-gray-600 leading-snug italic">{frontmatter.imageCaption}</p>
                    : <p class="text-xs text-gray-300 italic select-none">— no caption —</p>
                  }
                </div>
              </div>
            </div>
          )}

          <p class="text-xs font-black uppercase tracking-widest text-gray-400 mb-3">Abstract</p>
          <div class="[&_p]:mb-5 [&_p]:leading-relaxed [&_h2]:font-black [&_h3]:font-black [&_a]:underline [&_strong]:font-black">
            <slot />
          </div>
          <div class="clear-both"></div>

          <!-- BibTeX block -->
          <div class="mt-12 border-2 border-black">
            <button
              id="bibtex-toggle"
              class="w-full flex items-center justify-between px-4 py-3 font-bold text-sm hover:bg-gray-50 transition-colors"
            >
              <span>Cite (BibTeX)</span>
              <span id="bibtex-arrow" class="text-lg leading-none">+</span>
            </button>
            <div id="bibtex-block" class="hidden border-t-2 border-black">
              <div class="relative">
                <pre class="text-xs p-4 overflow-x-auto bg-white font-mono leading-relaxed whitespace-pre">{bibtex}</pre>
                <button
                  id="copy-btn"
                  class="absolute top-3 right-3 text-xs px-3 py-1 border-2 border-black bg-white font-bold hover:shadow-[2px_2px_0px_rgba(0,0,0,1)] transition-shadow"
                >
                  Copy
                </button>
              </div>
            </div>
          </div>

        </div>

        <!-- ── RIGHT: sticky sidebar ── -->
        <div class="w-full md:w-56 flex-shrink-0 md:sticky md:top-32 space-y-4">

          <!-- PDF / DOI buttons — top of sidebar -->
          {frontmatter.pdf && (
            <a
              href={frontmatter.pdf}
              download
              class="flex items-center justify-center gap-2 w-full px-3 py-2.5 border-2 border-black font-bold text-sm bg-white hover:shadow-[3px_3px_0px_rgba(0,0,0,1)] transition-shadow"
            >
              <i class="ri-download-line text-lg"></i> Download PDF
            </a>
          )}

          {frontmatter.doi && (
            <a
              href={frontmatter.doi}
              target="_blank"
              class="flex items-center justify-center gap-2 w-full px-3 py-2.5 border-2 border-black font-bold text-sm bg-white hover:shadow-[3px_3px_0px_rgba(0,0,0,1)] transition-shadow"
            >
              <i class="ri-external-link-line text-lg"></i> View DOI
            </a>
          )}

          {(frontmatter.pdf || frontmatter.doi) && (
            <div class="border-t-2 border-dashed border-gray-300"></div>
          )}

          <!-- Type sticker -->
          <div
            class="inline-block border-2 border-black px-4 py-2 font-black text-sm uppercase tracking-widest shadow-[3px_3px_0px_rgba(0,0,0,0.3)] select-none relative transition-transform hover:rotate-0"
            style={`background: ${accent}; transform: rotate(-1.5deg);`}
          >
            <span class="absolute -top-2 left-1/2 -translate-x-1/2 w-8 h-3 bg-[#FFDC58] border border-yellow-400 opacity-80"></span>
            {frontmatter.type}
          </div>

          <!-- Author cards — one per author -->
          <div class="space-y-3 pt-1">
            <p class="text-[10px] font-black uppercase tracking-wider text-gray-400">Author(s)</p>
            {authors.map((author, i) => {
              const tape    = tapeColors[i % tapeColors.length];
              const rot     = rotations[i % rotations.length];
              const initials = author.name.split(' ').map((p: string) => p[0]).join('').slice(0, 2).toUpperCase();
              const hasLink  = author.url && author.url.trim() !== '';
              return (
                <div
                  class={`relative bg-white border-2 border-black p-3 shadow-[3px_3px_0px_rgba(0,0,0,0.2)] transition-transform hover:rotate-0 ${hasLink ? 'cursor-pointer group' : ''}`}
                  style={`transform: rotate(${rot});`}
                >
                  <span class="absolute -top-2 left-1/2 -translate-x-1/2 w-8 h-3 border opacity-80" style={`background: ${tape}; border-color: ${tape};`}></span>
                  <div class="flex items-center gap-2">
                    <!-- Initials circle -->
                    <div
                      class="w-7 h-7 rounded-full border-2 border-black flex items-center justify-center text-[9px] font-black flex-shrink-0"
                      style={`background: ${tape};`}
                    >
                      {initials}
                    </div>
                    <div class="flex-1 min-w-0">
                      {hasLink ? (
                        <a
                          href={author.url}
                          target="_blank"
                          class="text-xs font-bold leading-snug hover:underline flex items-center gap-1 group-hover:underline"
                        >
                          {author.name}
                          <i class="ri-external-link-line text-[10px] text-gray-400 flex-shrink-0"></i>
                        </a>
                      ) : (
                        <p class="text-xs font-bold leading-snug">{author.name}</p>
                      )}
                    </div>
                  </div>
                </div>
              );
            })}
          </div>

          <!-- Venue -->
          <div
            class="bg-white border-2 border-black p-3 shadow-[3px_3px_0px_rgba(0,0,0,0.2)] relative transition-transform hover:rotate-0"
            style="transform: rotate(-1deg);"
          >
            <span class="absolute -top-2 left-1/2 -translate-x-1/2 w-8 h-3 bg-[#AEF5D4] border border-green-300 opacity-80"></span>
            <p class="text-[10px] font-black uppercase tracking-wider text-gray-400 mb-1">Venue</p>
            <p class="text-xs font-medium leading-snug">{frontmatter.venue}</p>
          </div>

          <!-- Year -->
          {frontmatter.pubDate && (
            <div
              class="border-2 border-black px-3 py-2 bg-[#FFDC58] shadow-[3px_3px_0px_rgba(0,0,0,0.2)] relative transition-transform hover:rotate-0"
              style="transform: rotate(0.8deg);"
            >
              <span class="absolute -top-2 left-1/2 -translate-x-1/2 w-8 h-3 bg-[#CCA0FF] border border-purple-300 opacity-80"></span>
              <p class="text-[10px] font-black uppercase tracking-wider text-gray-400 mb-0.5">Year</p>
              <p class="text-xl font-black">{new Date(frontmatter.pubDate).getFullYear()}</p>
            </div>
          )}

          <!-- Keywords -->
          {frontmatter.keywords && (
            <div
              class="bg-white border-2 border-black p-3 shadow-[3px_3px_0px_rgba(0,0,0,0.2)] relative transition-transform hover:rotate-0"
              style="transform: rotate(-0.5deg);"
            >
              <span class="absolute -top-2 left-1/2 -translate-x-1/2 w-8 h-3 bg-[#FFDC58] border border-yellow-300 opacity-80"></span>
              <p class="text-[10px] font-black uppercase tracking-wider text-gray-400 mb-2">Keywords</p>
              <div class="flex flex-wrap gap-1">
                {frontmatter.keywords.split(',').map((k: string) => (
                  <span class="text-[10px] px-2 py-0.5 bg-gray-100 border border-gray-300">{k.trim()}</span>
                ))}
              </div>
            </div>
          )}

          <!-- Toggle note cards -->
          {frontmatter.notes?.length > 0 && (
            <div class="space-y-2 pt-2">
              <div class="border-t-2 border-dashed border-gray-300 mb-3"></div>
              {frontmatter.notes.map((note: any, i: number) => {
                const noteColors = ['#CCA0FF', '#FEA7CC', '#AEF5D4', '#FFDC58', '#33BFFF'];
                const c = noteColors[i % noteColors.length];
                return (
                  <div
                    class="note-card border-2 border-black bg-white shadow-[2px_2px_0px_rgba(0,0,0,0.2)] relative overflow-hidden"
                    style={`transform: rotate(${i % 2 === 0 ? '-1' : '1'}deg); transition: transform 0.2s ease;`}
                    onmouseenter="this.style.transform='rotate(0deg)'"
                    onmouseleave={`this.style.transform='rotate(${i % 2 === 0 ? '-1' : '1'}deg)'`}
                  >
                    <!-- tab / header button -->
                    <button
                      class="note-toggle w-full flex items-center gap-2 px-3 py-2 text-left font-bold text-xs"
                      style={`background: ${c};`}
                    >
                      {note.icon && <span class="text-sm leading-none">{note.icon}</span>}
                      <span class="flex-1 leading-snug">{note.title}</span>
                      <span class="note-arrow text-base leading-none ml-auto">+</span>
                    </button>
                    <!-- body — rolls open -->
                    <div class="note-body" style="max-height: 0; overflow: hidden; transition: max-height 0.35s ease, opacity 0.3s ease; opacity: 0;">
                      <p class="text-xs leading-relaxed text-gray-700 px-3 py-3">{note.text}</p>
                    </div>
                  </div>
                );
              })}
            </div>
          )}

        </div>
        <!-- end sidebar -->

      </div>
    </div>
  </article>

  <AppFooter />
</Layout>

<script is:inline>
  // BibTeX toggle
  const toggle = document.getElementById('bibtex-toggle');
  const block  = document.getElementById('bibtex-block');
  const arrow  = document.getElementById('bibtex-arrow');
  toggle?.addEventListener('click', () => {
    block.classList.toggle('hidden');
    arrow.textContent = block.classList.contains('hidden') ? '+' : '−';
  });

  // Copy BibTeX
  document.getElementById('copy-btn')?.addEventListener('click', () => {
    const text = document.querySelector('#bibtex-block pre')?.textContent ?? '';
    navigator.clipboard.writeText(text).then(() => {
      const btn = document.getElementById('copy-btn');
      btn.textContent = 'Copied!';
      setTimeout(() => { btn.textContent = 'Copy'; }, 2000);
    });
  });

  // Note card toggles
  document.querySelectorAll('.note-toggle').forEach(btn => {
    btn.addEventListener('click', () => {
      const card  = btn.closest('.note-card');
      const body  = card.querySelector('.note-body');
      const arrow = btn.querySelector('.note-arrow');
      const isOpen = body.style.maxHeight !== '0px' && body.style.maxHeight !== '';

      if (isOpen) {
        body.style.maxHeight = '0';
        body.style.opacity   = '0';
        arrow.textContent    = '+';
      } else {
        body.style.maxHeight = body.scrollHeight + 'px';
        body.style.opacity   = '1';
        arrow.textContent    = '−';
      }
    });
  });

  // Lightbox
  const polaroidImg = document.getElementById('polaroid-img');
  if (polaroidImg) {
    // Create overlay
    const overlay = document.createElement('div');
    overlay.style.cssText = `
      display: none; position: fixed; inset: 0; z-index: 1000;
      background: rgba(0,0,0,0.85); cursor: zoom-out;
      align-items: center; justify-content: center;
    `;

    const fullImg = document.createElement('img');
    fullImg.src = polaroidImg.src;
    fullImg.style.cssText = `
      max-width: 90vw; max-height: 90vh; object-fit: contain;
      border: 3px solid white; box-shadow: 0 0 60px rgba(0,0,0,0.5);
    `;

    overlay.appendChild(fullImg);
    document.body.appendChild(overlay);

    polaroidImg.addEventListener('click', () => {
      overlay.style.display = 'flex';
      document.body.style.overflow = 'hidden';
    });

    overlay.addEventListener('click', () => {
      overlay.style.display = 'none';
      document.body.style.overflow = '';
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') { overlay.style.display = 'none'; document.body.style.overflow = ''; }
    });
  }
</script>
