---
import '../styles/global.css'
import Layout from '../layouts/Layout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';

const { frontmatter } = Astro.props;
---

<Layout>
  <Header />

  <article class="pt-10 pb-32 px-4">
    <div class="max-w-2xl mx-auto">

      <!-- Back -->
      <a href="/projects/" class="inline-flex items-center gap-1 text-sm text-gray-500 hover:text-black transition-colors mb-8">
        ← Back to Projects
      </a>

      <!-- Colour bar + title -->
      <div class="border-2 border-black mb-10 overflow-hidden">
        <!-- accent bar -->
        <div class="h-3 w-full" style={`background: ${frontmatter.color}`}></div>

        <div class="bg-white p-8">
          <h1 class="text-3xl font-black leading-snug mb-2">{frontmatter.title}</h1>
          <p class="text-gray-500 font-medium mb-6">{frontmatter.role}</p>

          <!-- meta row -->
          <div class="flex flex-wrap gap-6 text-sm text-gray-500 border-t border-gray-100 pt-4 mb-6">
            <span><span class="font-bold text-black">Period</span> — {frontmatter.year}</span>
            <span><span class="font-bold text-black">Location</span> — {frontmatter.location}</span>
          </div>

          <!-- Tags -->
          <div class="flex flex-wrap gap-2">
            {frontmatter.tags?.map((tag: string) => (
              <span
                class="text-xs px-3 py-1 border-2 border-black font-medium"
                style={`background: ${frontmatter.color}`}
              >
                {tag}
              </span>
            ))}
          </div>
        </div>
      </div>

      <!-- Body -->
      <div class="prose prose-lg max-w-none
        prose-headings:font-black
        prose-a:underline">
        <slot />
      </div>

    </div>
  </article>

  <Footer />
</Layout>
