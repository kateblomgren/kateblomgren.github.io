---
import '../styles/global.css'
import Layout from "../layouts/Layout.astro";
import AppHeader from '../components/Header.astro';
import AppFooter from '../components/Footer.astro';

// ── Toggle this to show/hide the real projects page ──────────────────
const COMING_SOON = true;
// ─────────────────────────────────────────────────────────────────────

const allProjects = COMING_SOON ? [] : (Object.values(
  import.meta.glob('./projects/*.md', { eager: true })
) as any[]).filter((p: any) => !p.file?.split("/").pop()?.startsWith("_"));

// Sort by the `order` frontmatter field (ascending), fallback to 99
const projects = allProjects
  .sort((a, b) => (a.frontmatter.order ?? 99) - (b.frontmatter.order ?? 99));
---

<Layout>
  <AppHeader />

  {COMING_SOON ? (

    <section class="min-h-[70vh] flex items-center justify-center px-4 py-20">
      <div class="relative border-3 border-black bg-white shadow-[6px_6px_0px_rgba(0,0,0,0.15)] flex flex-col items-center text-center md:flex-row md:items-center md:text-left gap-6 p-8 max-w-[420px] w-full">
        <div class="size-2 bg-white border-2 border-black absolute -top-1.5 -right-1.5"></div>
        <div class="size-2 bg-white border-2 border-black absolute -top-1.5 -left-1.5"></div>
        <div class="size-2 bg-white border-2 border-black absolute -bottom-1.5 -left-1.5"></div>
        <div class="size-2 bg-white border-2 border-black absolute -bottom-1.5 -right-1.5"></div>
        <img src="/stickers/girl-with-books.png" alt="Girl with books" class="w-16 sm:w-24 md:w-32 flex-shrink-0 drop-shadow-md" />
        <div>
          <p class="text-xs font-black uppercase tracking-widest text-gray-400 mb-1">Coming soon</p>
          <h1 class="text-3xl font-black mb-2">Projects</h1>
          <p class="text-sm text-gray-500 leading-relaxed">This page is still being put together. Check back soon.</p>
        </div>
      </div>
    </section>

  ) : (

    <section class="pt-16 pb-32">
      <div class="max-w-3xl mx-auto px-4">

        <div class="text-center mt-6 mb-12">
          <h1 class="text-5xl font-black">Projects</h1>
        </div>

        <div class="space-y-6">
          {projects.map(({ frontmatter, compiledContent, url }: any) => (
            <a
              href={url}
              class="block bg-white border-2 border-black p-8 transition-all duration-200 hover:shadow-[4px_4px_0px_rgba(0,0,0,0.3)] hover:-translate-y-0.5"
              style={`border-left: 6px solid ${frontmatter.color}`}
            >
              <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-2 mb-3">
                <div>
                  <h2 class="text-xl font-bold">{frontmatter.title}</h2>
                  <p class="text-gray-500 text-sm">{frontmatter.role}</p>
                </div>
                <div class="text-right flex-shrink-0">
                  <p class="text-sm text-gray-400">{frontmatter.year}</p>
                  <p class="text-sm text-gray-400">{frontmatter.location}</p>
                </div>
              </div>
              <div class="text-sm leading-relaxed mb-4 prose prose-sm max-w-none" set:html={compiledContent()} />
              <div class="flex flex-wrap gap-2">
                {frontmatter.tags?.map((tag: string) => (
                  <span class="text-xs px-3 py-1 border border-black font-medium">{tag}</span>
                ))}
              </div>
            </a>
          ))}
        </div>

      </div>
    </section>

  )}

  <AppFooter />
</Layout>
