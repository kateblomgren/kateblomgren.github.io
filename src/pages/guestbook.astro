---
import '../styles/global.css'
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

import GuestbookCard from "../components/GuestbookCard.astro";

import { db, Guestbook } from "astro:db";

const variants = [
  { pill: 'bg-pink-200',   country: 'bg-purple-300', countryPos: 'bottom-0 right-6 translate-y-1/2 -rotate-6' },
  { pill: 'bg-blue-200',   country: 'bg-pink-300',   countryPos: 'bottom-0 right-6 translate-y-1/2 rotate-3'  },
  { pill: 'bg-purple-300', country: 'bg-blue-200',   countryPos: 'bottom-0 right-6 translate-y-1/2 -rotate-3' },
  { pill: 'bg-red-300',    country: 'bg-yellow-300', countryPos: 'top-0 right-6 -translate-y-1/2 rotate-6'    },
];

// HANDLE FORM SUBMISSION
if (Astro.request.method === "POST") {
  const formData = await Astro.request.formData();

  const name = formData.get("name")?.toString().trim();
  const message = formData.get("message")?.toString().trim();
  const country = formData.get("country")?.toString().trim();
  const link = formData.get("link")?.toString().trim();

  if (!name || !message || !country) {
    return Astro.redirect("/guestbook?error=missing");
  }

  await db.insert(Guestbook).values({
    author: name,
    content: message,
    country,
    link: link || null,
    timestamp: new Date(),
  });

  return Astro.redirect("/guestbook?success=true");
}

// FETCH ENTRIES
const entries = await db.select().from(Guestbook).all();
