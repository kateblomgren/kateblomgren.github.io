---
import Button from "./Button.astro"
import Bars from "./Bars.astro"

import svgRedStar from '../assets/red-star.svg'
import svgIdea from '../assets/idea.svg'
import svgArrow from '../assets/arrow.svg'
import svgString from '../assets/string.svg'

import { author } from '../sample'
---

<section class="pb-20 relative">
    <div class="max-w-4xl mx-auto p-4 pt-16 md:pt-24">
      <div class="grid grid-cols-1 md:grid-cols-[60%_40%] items-center">
        <div class="flex flex-col gap-4 pr-0 md:pr-10">
            <h1 class="group relative inline-block text-5xl font-bold">
              <span class="transition-opacity duration-200 group-hover:opacity-0">Kate Blomgren</span>
              <span class="absolute inset-0 opacity-0 transition-opacity duration-200 group-hover:opacity-100">Caterina Blomgren</span>
            </h1>
            <h2 class="text-3xl font-medium">
              <span class="underline decoration-dotted cursor-pointer" onclick="addSticker('/Untitled_Artwork-10.png')">PhD student</span><span> asking </span><span class="relative inline-block">
                <span class="absolute bg-[#FFDC58] w-full h-[45%] left-0 bottom-0 z-1"></span>
                <span class="relative z-5">uncomfortable</span>
              </span><span> questions</span>
            </h2>
            <p class="text-xl">I'm a PhD student at Linköping University, Campus Norrköping, focusing on the sociotechnical dimensions of HCI, the entanglement of systems and power, and using <span class="underline decoration-dotted cursor-pointer" onclick="addSticker('/Untitled_Artwork-6.png')">critical reflections</span> to examine how technical systems affect people.</p>
           <div class="flex mt-5">
             <Button text="My Research Outputs" link="/outputs" />
           </div>
        </div>
        <div class="relative mt-40 md:mt-0">
          <div class="flex absolute -top-20 left-0 z-10">
            <div class="flex transform -rotate-30 translate-y-3">
              <svg class="size-5" viewBox="0 0 37 35" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M19.5479 4.4031C18.6713 5.80238 19.9271 9.81219 21.7001 11.2897C23.0602 12.3947 24.0665 11.888 24.3315 9.94798C24.6359 7.90326 23.1377 5.00064 21.4323 4.27109C20.1328 3.70088 19.9764 3.72964 19.5479 4.4031Z" fill="black"/>
                <path d="M7.84038 5.33376C6.96374 6.73304 8.21957 10.7429 9.99262 12.2204C11.3527 13.3254 12.359 12.8186 12.624 10.8786C12.9284 8.83392 11.4302 5.9313 9.72476 5.20175C8.42528 4.63154 8.26883 4.66031 7.84038 5.33376Z" fill="black"/>
                <path d="M2.88193 16.7075C3.24136 18.9226 7.35405 23.0018 11.0101 24.7375C12.1376 25.3003 14.0826 25.7031 15.8021 25.7769C18.5025 25.8751 18.8859 25.7851 22.3741 24.1786C25.7215 22.637 26.2387 22.2689 27.844 20.4042C29.889 17.9907 31.8424 12.8058 31.2223 11.3601C30.6796 10.095 29.8918 10.7176 28.3133 13.8252C26.5656 17.2272 25.5918 18.4981 23.558 19.9541C21.6144 21.3254 17.9796 22.3934 15.6935 22.2776C12.9776 22.1433 7.87127 19.3874 5.0947 16.5541C3.68105 15.1275 2.64514 15.1717 2.88193 16.7075Z" fill="black"/>
              </svg>
              <span class="uppercase font-black">{author.name}</span>
            </div>
            <img src={svgArrow.src} width="80" class="-translate-x-10" alt="arrow icon" />
          </div>

          <div class="relative p-8 bg-white">
            <img src={svgRedStar.src} width="80" alt="red-star" class="absolute bottom-1 right-1 z-10" />
            <img src={svgIdea.src} width="60" alt="idea" class="absolute top-16 -left-3 z-10" />
            <img src={svgString.src} width="50" alt="string" class="absolute -top-6 -right-2 z-10" />

            <div class="group/photo relative w-full h-[310px] border-2 bg-white flex items-center justify-center cursor-default">
              <img src="/Untitled_Artwork-15.png" alt="Just like other girls illustration" class="h-full w-full object-contain" />

              <!-- Tooltip -->
              <div class="pointer-events-none absolute -top-2 -left-2 -right-2 opacity-0 group-hover/photo:opacity-100 transition-opacity duration-200 z-20 bg-white border-2 border-black p-4 shadow-[4px_4px_0px_rgba(0,0,0,1)]">
                <p class="font-bold text-sm mb-2">Kate Blomgren</p>
                <ul class="text-xs space-y-0.5 text-gray-700 leading-snug">
                  <li>Critical Researcher,</li>
                  <li>Mother of Cats,</li>
                  <li>Disturber of Systems,</li>
                  <li>Accidental Island Dweller,</li>
                  <li>Reader of Footnotes and Between the Lines,</li>
                  <li>Crocheter of Things That Probably Don't Need Crocheting,</li>
                  <li>Translator of Technical Things into Human Problems,</li>
                  <li>Occasional Saver of Zelda,</li>
                  <li>and Personally Appointed Chauffeur of the Passenger Princess</li>
                </ul>
              </div>
            </div>

            <Bars />
          </div>
        </div>

      </div>
    </div>

    <img src="/elements/Asset%2018.svg" alt="" width="60" class="absolute -bottom-4" />
  </section>
