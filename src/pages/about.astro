---
import '../styles/global.css'
import Layout from "../layouts/Layout.astro"

import Header from '../components/Header.astro'
import Tools from '../components/Tools.astro'
import Footer from '../components/Footer.astro'

const researchInterests = [
  "Sociotechnical HCI: the values, practices and people behind technology",
  "Critical data visualization, especially around authorship, credit and recognition in collaborative settings such as science museums",
  "Visibility and labour: how contributions are acknowledged or overlooked in public-facing technologies and institutions",
  "Participatory and playful design methods, including games as a way to engage with complex topics such as AI",
  "Procedural critique and representation in games, including how simulation and interaction encode values and social assumptions",
  "AI and large language models, including their use in qualitative research",
]

const education = [
  {
    title: "PhD in Media and Technology",
    university: "Linköping University",
    place: "August 2024 – present · Norrköping, Sweden",
    description: "PhD research in HCI and data visualization, focusing on science museums: how contributions are credited and made visible, and how visualization and interactive media communicate science to the public. Informed by feminist theory."
  },
  {
    title: "MA in Game Design",
    university: "Uppsala University – Campus Gotland",
    place: "September 2021 – June 2023 · Visby, Sweden",
    description: "The thesis focused on how game mechanics can reflect and reproduce social values through procedural systems, offering feminist frameworks for game analysis and design."
  },
  {
    title: "BA in Advertising",
    university: "University of the Arts London – LCC",
    place: "September 2013 – June 2016 · London, United Kingdom",
    description: "Studied advertising strategy, creative direction, and visual storytelling within interdisciplinary teams and international contexts."
  },
]

const teaching = [
  {
    title: "Supervisor – Bachelor's Thesis in Graphic Design and Communication",
    company: "Linköping University",
    year: "March 2025 – June 2025 · Norrköping, Sweden",
    description: "Supervising a 16-credit thesis in Graphic Design and Communication, focusing on research framing, literature review, methodology, and ethical reflection."
  },
  {
    title: "Co-Supervisor – Bachelor's Degree Project in Game Design and Graphics",
    company: "Uppsala University",
    year: "January 2024 – June 2024 · Visby, Sweden",
    description: "Supported students in academic writing, critical reflection, and structuring research questions in alignment with social and ethical concerns."
  },
]

const skills = [
  { label: "Qualitative research", desc: "Designing interview protocols, conducting interviews, and analyzing responses through thematic and critical approaches" },
  { label: "Academic writing", desc: "Structuring theses and research papers, conducting literature reviews, and formulating arguments with clarity" },
  { label: "Workshop facilitation", desc: "Designing and leading participatory activities focused on ethics, recognition, and collaboration in interdisciplinary contexts" },
  { label: "Research-through-design", desc: "Applying speculative, feminist, and participatory design methods in academic and collaborative projects" },
  { label: "Visual communication", desc: "Graphic design, branding, layout, and visual storytelling for both academic and public-facing audiences" },
  { label: "Basic web development", desc: "Knowledge of HTML, CSS, and JavaScript for prototyping interactive research tools and digital storytelling" },
  { label: "Interdisciplinary collaboration", desc: "Experience working across design, education, and science institutions in both research and applied settings" },
  { label: "Project planning & coordination", desc: "Managing timelines, documentation, and team communication in both academic and creative environments" },
]

const projects = [
  {
    title: "Crediting Practices in Science Museums",
    role: "Lead PhD Researcher",
    year: "January 2024 – present · Norrköping, Sweden",
    description: "Interview study with people working in science museums on who gets credited for interactive exhibits, which work becomes visible or invisible, and how those decisions are made. Resulted in a paper at IEEE VIS 2026."
  },
  {
    title: "GECO – Gamify Energy Communities",
    role: "Researcher",
    year: "October 2023 – May 2024 · Gotland, Sweden",
    description: "Developing gamified facilitation tools to support inclusive and sustainable group dynamics in rural energy communities through design-driven research."
  },
  {
    title: "Erasmus+ ROCKET & EDGE Projects",
    role: "Graphic Designer",
    year: "February 2023 – June 2024 · Sweden / Germany / The Netherlands",
    description: "Designing visual materials and user interfaces for international education projects focused on role-playing games, inclusion, and interdisciplinary collaboration in higher education."
  },
]

const languages = [
  { lang: "Ukrainian", level: "Native proficiency" },
  { lang: "English", level: "Full professional proficiency" },
  { lang: "Swedish", level: "Intermediate proficiency" },
]
---


<Layout>

    <Header />

    <a href="/guestbook/" class="absolute right-0 top-0 m-4 px-3 py-1 bg-yellow-300 border-2 border-black rounded z-20" data-i18n="about.contact_button">Get in Touch</a>

    <div id="sticker-book" class="hidden md:block absolute right-0 top-0 w-64 h-[2000px] pointer-events-none"></div>

    <!-- Bio -->
    <section class="max-w-3xl mx-auto py-16 px-6">
      <div class="flex flex-col md:flex-row gap-10 items-start">
        <div class="flex-1 paper p-6 md:p-8">
          <h1 class="text-4xl font-medium mb-6" data-i18n="about.heading">About Me</h1>
          <p class="text-lg leading-relaxed" data-i18n-html="about.bio_1_html">
            I'm a PhD researcher in Data Visualisation at <a href="https://visidlab.github.io/" class="font-bold underline" target="_blank">Linköping University</a>, working in HCI and data visualization. Originally from <span class="underline cursor-pointer" onclick="addSticker('/stickers/places-things/uk-tri.png', this)">Ukraine</span>, I'm now based in <span class="underline cursor-pointer" onclick="addSticker('/stickers/places-things/norrkoping-campus.png', this)">Norrköping, Sweden</span>.
          </p>
          <p class="text-lg leading-relaxed mt-4" data-i18n="about.bio_2">
            I'm interested in the sociotechnical side of technology: not only how it works, but the values, practices, people and structures around it. Informed by feminist theory, I ask whose work gets recognised and how things that seem neutral or technical are shaped by particular people and decisions. My research includes credit and contribution in science museums, visualization and interactive media for communicating science to the public, and the role of AI and large language models in how we explain, analyse and understand things. The common thread is what technological systems make visible, and what they hide.
          </p>
          <p class="text-lg leading-relaxed mt-4" data-i18n-html="about.bio_4_html">
            Outside of research, I spend my time with my wife, <span class="underline cursor-pointer" onclick="addSticker('/stickers/pets/orange-cat-standing.png', this)">our two cats</span>, and our <span class="underline cursor-pointer" onclick="addSticker('/stickers/pets/dog-in-box.png', this)">dog</span>. I love video games, crocheting, Lego, and board games.
          </p>
        </div>
        <div class="w-full md:w-[240px] flex-shrink-0 space-y-6">
          <!-- Photo: hover to draw cat doodles on it (coordinates match kate-b.jpg, 1254×1254) -->
          <div class="doodle-photo relative border-2 border-black" tabindex="0">
            <img src="/kate-b.jpg" alt="Kate Blomgren portrait" class="block w-full aspect-square object-cover" />
            <svg class="absolute inset-0 w-full h-full pointer-events-none" viewBox="0 0 1254 1254" aria-hidden="true">
              <defs><filter id="blush-blur"><feGaussianBlur stdDeviation="10" /></filter></defs>
              <g class="doodle d-ears" stroke="#1d1d1d" stroke-width="10" stroke-linejoin="round" stroke-linecap="round">
                <path d="M330 232 Q322 128 362 40 Q430 108 494 182 Q410 196 330 232 Z" fill="#2b2b2b" />
                <path d="M362 192 Q360 130 378 92 Q412 128 442 170 Q400 176 362 192 Z" fill="#FEA7CC" stroke="none" />
                <path d="M884 248 Q892 142 852 54 Q784 122 720 196 Q804 210 884 248 Z" fill="#2b2b2b" />
                <path d="M852 206 Q854 144 836 106 Q802 142 772 184 Q814 190 852 206 Z" fill="#FEA7CC" stroke="none" />
              </g>
              <g class="doodle d-blush">
                <ellipse cx="452" cy="660" rx="66" ry="32" fill="#FF7FA8" opacity="0.5" filter="url(#blush-blur)" />
                <ellipse cx="748" cy="660" rx="66" ry="32" fill="#FF7FA8" opacity="0.5" filter="url(#blush-blur)" />
                <g stroke="#fff" stroke-width="7" stroke-linecap="round" opacity="0.9">
                  <path d="M428 676 L442 648 M450 676 L464 648 M472 676 L486 648" />
                  <path d="M724 676 L738 648 M746 676 L760 648 M768 676 L782 648" />
                </g>
              </g>
              <g class="doodle d-whiskers" fill="none" stroke="#1d1d1d" stroke-width="8" stroke-linecap="round">
                <path d="M396 632 Q320 612 236 606" /><path d="M392 664 Q314 662 228 670" /><path d="M396 694 Q322 712 246 738" />
                <path d="M808 632 Q884 612 968 606" /><path d="M812 664 Q890 662 976 670" /><path d="M808 694 Q882 712 958 738" />
              </g>
              <g class="doodle d-nose">
                <path d="M580 600 Q602 590 624 600 Q614 620 602 627 Q590 620 580 600 Z" fill="#FEA7CC" stroke="#1d1d1d" stroke-width="7" stroke-linejoin="round" />
              </g>
            </svg>
          </div>

          <!-- Supervisor card -->
          <a href="https://miriah.github.io/" target="_blank" class="block relative bg-[#CCA0FF] border-2 border-black px-4 py-3 shadow-[3px_3px_0px_rgba(0,0,0,0.25)] transition-transform hover:rotate-0 hover:shadow-[4px_4px_0px_rgba(0,0,0,0.35)]" style="transform: rotate(-1.5deg);">
            <span class="absolute -top-2 left-1/2 -translate-x-1/2 w-8 h-3 bg-[#FFDC58] border border-yellow-400 opacity-80"></span>
            <p class="text-[10px] font-black uppercase tracking-wider text-gray-600 mb-1" data-i18n="about.card_supervisor">Supervisor</p>
            <p class="text-sm font-bold leading-snug">Miriah Meyer</p>
            <p class="text-xs text-gray-700 mt-0.5 flex items-center gap-1">miriah.github.io <i class="ri-external-link-line text-[10px]"></i></p>
          </a>

          <!-- Lab card -->
          <a href="https://visidlab.github.io/" target="_blank" class="block relative bg-[#AEF5D4] border-2 border-black px-4 py-3 shadow-[3px_3px_0px_rgba(0,0,0,0.25)] transition-transform hover:rotate-0 hover:shadow-[4px_4px_0px_rgba(0,0,0,0.35)]" style="transform: rotate(1deg);">
            <span class="absolute -top-2 left-1/2 -translate-x-1/2 w-8 h-3 bg-[#FEA7CC] border border-pink-300 opacity-80"></span>
            <p class="text-[10px] font-black uppercase tracking-wider text-gray-600 mb-1" data-i18n="about.card_lab">Lab</p>
            <p class="text-sm font-bold leading-snug">Visualisation & Interaction Design Lab</p>
            <p class="text-xs text-gray-700 mt-0.5 flex items-center gap-1">visidlab.github.io <i class="ri-external-link-line text-[10px]"></i></p>
          </a>

          <!-- University card -->
          <a href="https://liu.se/en" target="_blank" class="block relative bg-white border-2 border-black px-4 py-3 shadow-[3px_3px_0px_rgba(0,0,0,0.25)] transition-transform hover:rotate-0 hover:shadow-[4px_4px_0px_rgba(0,0,0,0.35)]" style="transform: rotate(-1deg);">
            <span class="absolute -top-2 left-1/2 -translate-x-1/2 w-8 h-3 bg-[#FFDC58] border border-yellow-400 opacity-80"></span>
            <p class="text-[10px] font-black uppercase tracking-wider text-gray-400 mb-1" data-i18n="about.card_university">University</p>
            <p class="text-sm font-bold leading-snug">Linköping University</p>
            <p class="text-xs text-gray-500 mt-0.5 flex items-center gap-1">liu.se <i class="ri-external-link-line text-[10px]"></i></p>
          </a>

        </div>
      </div>
    </section>

    <Tools />

    <!-- CV -->
    <section class="max-w-3xl mx-auto py-16 px-4" id="cv-section">
      <div class="paper px-6 md:px-10 py-10">
      <div class="flex items-center justify-between mb-10">
        <h2 class="text-3xl font-bold" data-i18n="about.cv_heading">CV</h2>
        <a href="/BlomgrenCV.pdf" download class="px-4 py-2 border-2 border-black bg-white font-medium text-sm transition-all duration-200 hover:shadow-[3px_3px_0px_rgba(0,0,0,0.3)]">
          <span data-i18n="about.cv_download">Download CV ↓</span>
        </a>
      </div>

      <!-- Research Interests -->
      <div class="mb-12">
        <h3 class="text-xl font-bold border-b-2 border-black pb-2 mb-6" data-i18n="about.research_interests_heading">Research Interests</h3>
        <ul class="space-y-2">
          {researchInterests.map((item, i) => (
            <li class="flex gap-3">
              <span class="text-gray-400 mt-1">❖</span>
              <span data-i18n={`about.research_interests.${i}`}>{item}</span>
            </li>
          ))}
        </ul>
      </div>

      <!-- Education -->
      <div class="mb-12">
        <h3 class="text-xl font-bold border-b-2 border-black pb-2 mb-6" data-i18n="about.education_heading">Education</h3>
        <div class="space-y-8">
          {education.map((item, i) => (
            <div>
              <p class="font-bold" data-i18n={`about.education.${i}.title`}>{item.title}</p>
              <p class="text-gray-600" data-i18n={`about.education.${i}.university`}>{item.university}</p>
              <p class="text-sm text-gray-400 mb-2" data-i18n={`about.education.${i}.place`}>{item.place}</p>
              <p class="text-sm leading-relaxed" data-i18n={`about.education.${i}.description`}>{item.description}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- Teaching & Supervision -->
      <div class="mb-12">
        <h3 class="text-xl font-bold border-b-2 border-black pb-2 mb-6" data-i18n="about.teaching_heading">Teaching & Supervision</h3>
        <div class="space-y-8">
          {teaching.map((item, i) => (
            <div>
              <p class="font-bold" data-i18n={`about.teaching.${i}.title`}>{item.title}</p>
              <p class="text-gray-600" data-i18n={`about.teaching.${i}.company`}>{item.company}</p>
              <p class="text-sm text-gray-400 mb-2" data-i18n={`about.teaching.${i}.year`}>{item.year}</p>
              <p class="text-sm leading-relaxed" data-i18n={`about.teaching.${i}.description`}>{item.description}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- Academic & Design Projects -->
      <div class="mb-12">
        <h3 class="text-xl font-bold border-b-2 border-black pb-2 mb-6" data-i18n="about.projects_heading">Academic & Design Projects</h3>
        <div class="space-y-8">
          {projects.map((item, i) => (
            <div>
              <p class="font-bold">
                <span data-i18n={`about.projects.${i}.title`}>{item.title}</span>
                <span class="font-normal text-gray-600"> / <span data-i18n={`about.projects.${i}.role`}>{item.role}</span></span>
              </p>
              <p class="text-sm text-gray-400 mb-2" data-i18n={`about.projects.${i}.year`}>{item.year}</p>
              <p class="text-sm leading-relaxed" data-i18n={`about.projects.${i}.description`}>{item.description}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- Skills -->
      <div class="mb-12">
        <h3 class="text-xl font-bold border-b-2 border-black pb-2 mb-6" data-i18n="about.skills_heading">Skills</h3>
        <ul class="space-y-2">
          {skills.map((item, i) => (
            <li class="flex gap-3">
              <span class="text-gray-400 mt-1">❖</span>
              <span><span class="font-bold"><span data-i18n={`about.skills.${i}.label`}>{item.label}</span>:</span> <span data-i18n={`about.skills.${i}.desc`}>{item.desc}</span></span>
            </li>
          ))}
        </ul>
      </div>

      <!-- Languages -->
      <div class="mb-12">
        <h3 class="text-xl font-bold border-b-2 border-black pb-2 mb-6" data-i18n="about.languages_heading">Languages</h3>
        <ul class="space-y-2">
          {languages.map((item, i) => (
            <li class="flex gap-3">
              <span class="text-gray-400 mt-1">❖</span>
              <span><span class="font-bold" data-i18n={`about.languages.${i}.lang`}>{item.lang}</span> — <span data-i18n={`about.languages.${i}.level`}>{item.level}</span></span>
            </li>
          ))}
        </ul>
      </div>

      </div>
    </section>

    <Footer />

<style>
  /* Cat doodles drawn over the photo on hover / focus */
  .doodle-photo .doodle {
    opacity: 0;
    transform: scale(0.6);
    transform-box: fill-box;
    transform-origin: center;
    transition: opacity 0.2s ease, transform 0.35s cubic-bezier(.3,1.6,.5,1);
  }
  .doodle-photo:hover .doodle, .doodle-photo:focus .doodle { opacity: 1; transform: scale(1); }
  .doodle-photo:hover .d-ears, .doodle-photo:focus .d-ears { transition-delay: 0s; animation: ear-wiggle 1.6s ease-in-out 0.4s infinite; }
  .doodle-photo:hover .d-whiskers, .doodle-photo:focus .d-whiskers { transition-delay: 0.12s; }
  .doodle-photo:hover .d-nose, .doodle-photo:focus .d-nose { transition-delay: 0.2s; }
  .doodle-photo:hover .d-blush, .doodle-photo:focus .d-blush { transition-delay: 0.28s; }
  @keyframes ear-wiggle { 0%, 100% { transform: scale(1) rotate(0); } 50% { transform: scale(1) rotate(-1.5deg); } }
  @media (prefers-reduced-motion: reduce) { .doodle-photo .doodle { transition: opacity 0.2s; transform: none; animation: none !important; } }

  @media print {
    header, footer, #sticker-book, a[href="/guestbook/"] {
      display: none !important;
    }
    body {
      background: white;
    }
    #cv-section {
      padding-top: 0;
    }
  }
</style>

<script is:inline>
  window.addSticker = function (image, triggerEl) {
    if (window.innerWidth < 768) return;

    const container = document.getElementById('sticker-book');
    if (!container) return;
    if (document.querySelector(`[data-sticker="${image}"]`)) return;

    const containerRect = container.getBoundingClientRect();
    let startY = 80;
    if (triggerEl) {
      const elRect = triggerEl.getBoundingClientRect();
      startY = elRect.top - containerRect.top - 30;
    }
    const startX = Math.floor(Math.random() * 80 + 10);

    const sticker = document.createElement('img');
    sticker.src = image;
    sticker.setAttribute('data-sticker', image);
    sticker.className = 'absolute w-[110px] h-auto cursor-grab pointer-events-auto drop-shadow-[3px_3px_0_rgba(0,0,0,0.25)]';
    sticker.style.willChange = 'transform';
    sticker.style.transform = `translate(${startX}px, ${startY}px) scale(0)`;
    sticker.style.transition = 'transform 0.2s ease';

    requestAnimationFrame(() => {
      sticker.style.transform = `translate(${startX}px, ${startY}px) scale(1)`;
    });

    let isDragging = false;
    let offsetX = 0, offsetY = 0;
    let currentX = startX, currentY = startY;
    let rafId = null;

    sticker.addEventListener('mousedown', (e) => {
      isDragging = true;
      const rect = sticker.getBoundingClientRect();
      offsetX = e.clientX - rect.left;
      offsetY = e.clientY - rect.top;
      sticker.style.cursor = 'grabbing';
      sticker.style.transition = 'none';
      e.preventDefault();
    });

    document.addEventListener('mousemove', (e) => {
      if (!isDragging) return;
      const cRect = container.getBoundingClientRect();
      currentX = e.clientX - cRect.left - offsetX;
      currentY = e.clientY - cRect.top - offsetY;
      if (rafId) cancelAnimationFrame(rafId);
      rafId = requestAnimationFrame(() => {
        sticker.style.transform = `translate(${currentX}px, ${currentY}px) scale(1)`;
      });
    });

    document.addEventListener('mouseup', () => {
      isDragging = false;
      sticker.style.cursor = 'grab';
      sticker.style.transition = 'transform 0.2s ease';
    });

    container.appendChild(sticker);
  }
</script>
</Layout>
