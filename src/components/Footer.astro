---
import { author } from '../sample'

const socials = [
  { icon: 'ri-mail-fill', link: 'mailto:kate.blomgren@liu.se' },
  { icon: 'ri-linkedin-box-fill', link: 'https://www.linkedin.com/feed/' },
  { icon: 'ri-bluesky-fill', link: 'https://bsky.app/profile/kateblom.bsky.social' },
  { icon: 'ri-graduation-cap-fill', link: 'https://scholar.google.com/citations?hl=en&user=dQbMpv8AAAAJ&view_op=list_works&gmla=AEk_c1tFv1NV_fIyQiNrIa1xWjGq0-5bbt0VvULp4FJ9AjOZeJSJ9xooT6HuvNlfk3qPuXNqHCDUQLvIBBM3-qRxhwv5zH31IfPDwyBCvhsmIPMkjdhexjguWHh771P1Ank_1e6tIbL4JmTSDSODUqU&iaan=Caterina+Blomgren' },
]

---

<footer class="border-t-4 px-5 md:px-0 py-10 mt-30 bg-[var(--main-bg)]">
    <div class="max-w-3xl mx-auto flex justify-center flex-col gap-5 md:gap-0 md:grid md:grid-cols-3 items-center">
      <div class="flex-1 font-bold">
        <a href="/" class="flex items-center gap-3 text-xl">
            <img src="/favicon.svg" alt="logo" width="30" /> {author.nickname}
        </a>
      </div>
      <div class="text-center">
        <p>© {new Date().getFullYear()} {author.nickname}. All rights reserved.</p>
      </div>
      <div class="flex md:justify-end gap-5">
        {socials.map(item => ( 
          <a href={item.link} target="_blank" class="transition-all duration-200 hover:translate-y-[2px]"><i class={`${item.icon} text-2xl`}></i></a>
        ))}
      </div>
    </div>
   </footer>
