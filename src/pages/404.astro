---
import '../styles/global.css'
import Layout from '../layouts/Layout.astro';
import AppHeader from '../components/Header.astro';
import AppFooter from '../components/Footer.astro';
---

<Layout>
  <AppHeader />

  <section class="min-h-[70vh] flex items-center justify-center px-4 py-20">

    <div class="relative border-3 border-black bg-white shadow-[6px_6px_0px_rgba(0,0,0,0.15)] flex flex-col items-center text-center md:flex-row md:items-center md:text-left gap-6 p-6 max-w-[420px] w-full">
      <!-- Corner squares -->
      <div class="size-2 bg-white border-2 border-black absolute -top-1.5 -right-1.5"></div>
      <div class="size-2 bg-white border-2 border-black absolute -top-1.5 -left-1.5"></div>
      <div class="size-2 bg-white border-2 border-black absolute -bottom-1.5 -left-1.5"></div>
      <div class="size-2 bg-white border-2 border-black absolute -bottom-1.5 -right-1.5"></div>

      <!-- Image: small on mobile, fixed on desktop -->
      <img
        src="/stickers/girl-on-fire.png"
        alt="Girl on fire"
        class="w-[30%] max-w-[140px] min-w-[60px] flex-shrink-0 drop-shadow-md"
      />

      <!-- Text -->
      <div>
        <p class="text-xs font-black uppercase tracking-widest text-gray-400 mb-1">Error 404</p>
        <h1 class="text-3xl font-black mb-2">Page not found</h1>
        <p class="text-sm text-gray-500 mb-5 leading-relaxed">
          This page doesn't exist — or maybe it used to and is now on fire.
        </p>
        <a href="/" class="inline-block px-4 py-2 border-2 border-black bg-[#FFDC58] font-bold text-sm hover:shadow-[3px_3px_0px_rgba(0,0,0,1)] transition-shadow">
          ← Back to Home
        </a>
      </div>
    </div>

  </section>

  <AppFooter />
</Layout>
